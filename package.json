{
  "name": "serialscout",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform desktop client for talking to UART / serial devices and CLIs.",
  "author": "",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox --no-zygote --disable-gpu",
    "build": "electron-vite build && npm run build:mcp",
    "start": "electron-vite preview -- --no-sandbox --no-zygote --disable-gpu",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --build",
    "build:mcp": "tsc --build tsconfig.mcp.json && node scripts/write-esm-marker.mjs",
    "mcp": "npm run build:mcp && node out/serial/mcp-stdio.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"serial/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.serialscout.app",
    "productName": "SerialScout",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "maintainer": "Tobias Wegner <git@tobiaswegner.de>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
